# ============================================
# متغيرات البيئة - مدى الناس
# انسخ هذا الملف إلى .env.local وأضف القيم
# ============================================

# قاعدة البيانات (Supabase / PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Auth
AUTH_SECRET=your-random-secret-at-least-32-chars
ADMIN_EMAIL=admin@madaalinsan.com
ADMIN_PASSWORD=StrongPassword123!
ADMIN_NAME=المدير العام

# الموقع
NEXT_PUBLIC_SITE_URL=https://madaalinsan.com

# Supabase Storage
SUPABASE_STORAGE_BUCKET=madaalinsan-media
